---
# Site settings for one OpenCTEM host. Copy to group_vars/all.yml in YOUR
# inventory directory (outside this repository). Never put a secret here:
# secrets are generated on the host, the tunnel token is placed there by you,
# and a webhook URL goes into an ansible-vault file (vault.yml below).

# --- Public name -------------------------------------------------------------------
# The ONE origin of the console, the API, sensors and CI. Cloudflare Access
# guards it; the exact machine paths get Access Bypass apps
# (docs/CLOUDFLARE-ACCESS.md) and authenticate in the API with their own keys.
openctem_app_host: ctem.example.com

# --- Release (must be a key of openctem_releases in versions.yml) ------------------
openctem_version: v0.15.1

# --- Private registry / air-gapped (optional; README "Private registry / air-gapped") ---
# The mirror must hold the images AND their cosign signatures (cosign copy / oras cp -r).
# openctem_registry_mirror: registry.example.com/openctem           # replaces ghcr.io/openctemio
# openctem_third_party_registry_mirror: registry.example.com/mirror # replaces docker.io / ghcr.io hosts, keeps paths
# openctem_registry_docker_config_dir: /root/.docker                # login for the cosign check
# openctem_registry_ca_file: /etc/ssl/certs/registry-ca.pem

# --- Ingress -----------------------------------------------------------------------
# loopback (default): gateway on 127.0.0.1:openctem_loopback_port for your own TLS proxy.
# cloudflared: Cloudflare Tunnel, no inbound port at all.
openctem_ingress: loopback
# When using cloudflared:
# cloudflared_management: remote   # tunnel route set in the Cloudflare dashboard
# cloudflared_management: local    # locally managed tunnel (cloudflared tunnel create)

# --- Administrator network: SSH is allowed only from here ---------------------------
admin_cidrs:
  - 192.0.2.0/24

# --- Backups -----------------------------------------------------------------------
# Your age PUBLIC key (age-keygen -y key.txt). Empty = local mode: plaintext,
# root-only, on the host only, off-host copy refused.
backup_age_recipient: ''
# Off-host copy of each encrypted backup ($1 = its directory), e.g.
#   rclone copy --config /root/.config/rclone/rclone.conf "$1" remote:openctem/$(basename "$1")
backup_offsite_command: ''
backup_keep_days: 14
# Backups are signed on the host. Keep the PUBLIC key OFF the host (the backup
# play prints the line) and give it to restores with --allowed-signers=FILE;
# setting it here also puts a copy on the host for the drill.
backup_signing_allowed_signers: ''
# Pruning the bucket from the host needs a key that can delete (root on the host
# could then wipe every off-host copy). Default false: use a write-only key and a
# lifecycle rule on the bucket (docs/BACKUP-PITR.md).
backup_wal_prune: false

# --- Monitoring --------------------------------------------------------------------
# A webhook URL is a credential: put it in group_vars/vault.yml (ansible-vault
# encrypt) as vault_monitoring_webhook_url.
monitoring_webhook_url: "{{ vault_monitoring_webhook_url | default('') }}"

# --- Hardening (see roles/os_baseline/defaults for all options) --------------------
# ssh_stage: 2                          # keys only (stage 1 keeps passwords)
# ssh_allow_users: [deploy]             # restrict SSH to named users (CIS 5.2.4)
# ssh_allow_groups: [sudo]
# docker_userns_remap: true             # user namespace remapping (CIS Docker 2.8)
# docker_icc: false                     # disable inter-container communication
# os_baseline_remote_syslog: siem.example.com   # centralized log shipping
# os_baseline_remote_syslog_port: 514
# monitoring_deadman_url: https://hc.example.com/ping/xxxx  # dead-man's-switch
# monitoring_email_to: soc@example.com  # second alerting channel

# --- Rocky Linux 9 (uncomment when targeting Rocky/Alma/RHEL 9) -------------------
# The Docker package versions below are for Rocky 9. Find the latest with:
#   dnf list --showduplicates docker-ce
# docker_rpm_ce_version: '29.9.0-1.el9'
# docker_rpm_containerd_version: '2.4.2-1.el9'
# docker_rpm_compose_plugin_version: '5.6.0-1.el9'

# --- Optional ----------------------------------------------------------------------
# openctem_job_signer: true      # signed sensor jobs (default; key created on the host)
# openctem_signer_ledger: audit  # audit while upgrading, enforce after the ledger import
# Sizing for 4 vCPU / 7-8 GB is the default; see roles/openctem/defaults/main.yml.

# --- Stages to apply (or pass -e apply_x=true per run) ------------------------------
apply_os: false
apply_ssh: false
apply_docker: false
apply_firewall: false
apply_openctem: false
apply_backup: false
apply_monitoring: false

# Platform console as its own service (releases flagged console_service).
# Recommended in production: its own host name behind its own Cloudflare
# Access application (docs/self-hosting-with-ansible.md). The default is a
# second port (loopback ingress only).
# openctem_admin_site: host
# openctem_admin_host: admin.example.com
# openctem_admin_allowed_cidrs: [203.0.113.0/24]
# openctem_admin_site: port        # needs openctem_ingress: loopback
# openctem_admin_port: 8443
# openctem_admin_bind: ''          # '' = 127.0.0.1; a private/VPN address only

# Hosted service: the platform administrators' audit chain must be copied out of
# the database (README, "Administrators' audit sink"). '' = off, 'file' or an
# https:// URL (create <secrets dir>/admin_audit_sink_secret on the server first).
# openctem_admin_audit_sink: https://audit.example.com/ingest
