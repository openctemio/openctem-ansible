#!/bin/sh
# {{ ansible_managed }}
# Generates the OpenCTEM secrets ON THIS SERVER (once) and assembles the env
# files the stack reads. Prints only file names, never a value. Run as root
# by roles/openctem. Never touches the tunnel token.
set -eu
umask 077
d='{{ openctem_secrets_dir }}'
[ -d "$d" ] || { echo "missing $d" >&2; exit 1; }

# gen <name> <bytes>: random hex, created once, 0400.
gen() {
	f="$d/$1"
	if [ -s "$f" ]; then return 0; fi
	openssl rand -hex "$2" > "$f.tmp"
	chmod 0400 "$f.tmp"
	mv -f "$f.tmp" "$f"
	echo "CHANGED generated $1"
}

val() { cat "$d/$1"; }

# put <name>: content from stdin, replaced only when it differs.
put() {
	f="$d/$1"
	cat > "$f.tmp"
	chmod 0400 "$f.tmp"
	if [ -f "$f" ] && cmp -s "$f.tmp" "$f"; then
		rm -f "$f.tmp"
	else
		mv -f "$f.tmp" "$f"
		echo "CHANGED rendered $1"
	fi
}

gen db_superuser_password 24
gen db_migrate_password 24
gen db_app_password 24
gen db_console_password 24
gen redis_password 32
# FINGERPRINT_KEY (required since v0.10.0): keys the fingerprint of every
# stored secret finding. An existing install must start with its CURRENT
# encryption key (the key its fingerprints were made with), copied here once
# on the server; a different value would give every known secret a new
# identity and reopen it as a new finding. A new install gets its own random
# key, independent of the encryption key. Decided before the encryption key
# is generated, so an interrupted first run can never mistake a new install
# for an existing one. Never generated for an existing
# install, never rotated with the encryption key.
if [ ! -s "$d/fingerprint_key" ]; then
	if [ -s "$d/app_encryption_key" ]; then
		cp "$d/app_encryption_key" "$d/fingerprint_key.tmp"
		chmod 0400 "$d/fingerprint_key.tmp"
		mv -f "$d/fingerprint_key.tmp" "$d/fingerprint_key"
		echo "CHANGED copied app_encryption_key to fingerprint_key (existing install)"
	else
		gen fingerprint_key 32
	fi
fi

gen app_encryption_key 32
gen metrics_token 32

put api.env <<EOT
DB_PASSWORD=$(val db_app_password)
{% if openctem_releases[openctem_version].console_db_role | default(false) | bool %}
DB_ADMIN_PASSWORD=$(val db_console_password)
{% endif %}
REDIS_PASSWORD=$(val redis_password)
APP_ENCRYPTION_KEY=$(val app_encryption_key)
FINGERPRINT_KEY=$(val fingerprint_key)
METRICS_TOKEN=$(val metrics_token)
$( [ -s "$d/captcha_turnstile_secret" ] && echo "CAPTCHA_TURNSTILE_SECRET=$(val captcha_turnstile_secret)" )
{% if openctem_admin_audit_sink is match('^https:') %}
ADMIN_AUDIT_SINK_SECRET=$(val admin_audit_sink_secret)
{% endif %}
EOT

put migrate.env <<EOT
PGPASSWORD=$(val db_migrate_password)
EOT

put db-roles.env <<EOT
PGPASSWORD=$(val db_superuser_password)
DB_PASSWORD=$(val db_app_password)
DB_MIGRATE_PASSWORD=$(val db_migrate_password)
{% if openctem_releases[openctem_version].console_db_role | default(false) | bool %}
DB_ADMIN_PASSWORD=$(val db_console_password)
{% endif %}
EOT

put redis.env <<EOT
REDISCLI_AUTH=$(val redis_password)
EOT

put redis.conf <<EOT
# Generated by openctem-secrets. TLS only, password required.
port 0
tls-port 6379
tls-auth-clients no
tls-cert-file /tls/server.crt
tls-key-file /tls/redis.key
tls-ca-cert-file /tls/ca.crt
appendonly yes
dir /data
requirepass $(val redis_password)
EOT
