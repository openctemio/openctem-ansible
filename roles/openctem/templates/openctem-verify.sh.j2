#!/bin/bash
# {{ ansible_managed }}
# Health and routing checks of the OpenCTEM stack, from inside the gateway
# (no host port exists to probe from outside). Exit 0 only when all pass.
# Used by roles/openctem after every deploy, by upgrades, and by the monitor.
set -u
# Compose is always called with an explicit project and file list, never
# from the working directory, and never for another stack's project.
ROOT='{{ openctem_root }}'
PROJECT='{{ openctem_project }}'
case "$PROJECT" in
''|{{ openctem_protected_projects | join('|') }}) echo "refusing compose project '$PROJECT'" >&2; exit 64 ;;
esac
compose_files=(-f "$ROOT/compose.yml")
[ -f "$ROOT/compose.cloudflared.yml" ] && compose_files+=(-f "$ROOT/compose.cloudflared.yml")
dc() { docker compose -p "$PROJECT" --project-directory "$ROOT" "${compose_files[@]}" "$@"; }
app='{{ openctem_app_host }}'
{% raw %}
fail=0
ok() { echo "OK   $*"; }
bad() { echo "FAIL $*"; fail=1; }

# Every long-running service is running and, where it has a healthcheck, healthy.
for svc in $(dc config --services); do
	case "$svc" in gateway-init|datastore-tls|db-roles|migrate) continue ;; esac
	id="$(dc ps -q "$svc" 2>/dev/null)"
	if [ -z "$id" ]; then bad "service $svc has no container"; continue; fi
	st="$(docker inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$id")"
	case "$st" in
	"running healthy"|"running none") ok "service $svc $st" ;;
	*) bad "service $svc $st" ;;
	esac
done

# No container of the project publishes a host port (loopback ingress excepted).
pub=""
while read -r name ports; do
	IFS=',' read -ra items <<< "$ports"
	for it in "${items[@]}"; do
		it="${it# }"
		case "$it" in
		127.0.0.1:*) ;;
		*'->'*) pub="$pub $name=$it" ;;
		esac
	done
done < <(docker ps --filter "label=com.docker.compose.project=$PROJECT" --format '{{.Names}} {{.Ports}}')
if [ -z "$pub" ]; then ok "no host port published beyond loopback"; else bad "published host port:$pub"; fi

# status <host> <port> <path>: HTTP status seen by the gateway itself.
status() {
	dc exec -T gateway sh -c 'wget -U openctem-verify -S -q -O /dev/null -T 10 --header "Host: $1" "http://127.0.0.1:$2$3" 2>&1 | sed -n "s/^ *HTTP\/[0-9.]* \([0-9][0-9]*\).*/\1/p" | tail -n 1' _ "$1" "$2" "$3"
}
expect() { # expect <want: code or !code> <host> <port> <path>
	got="$(status "$2" "$3" "$4")"
	case "$1" in
	!*) [ -n "$got" ] && [ "$got" != "${1#!}" ] && ok "$2:$3$4 -> $got" || bad "$2:$3$4 -> ${got:-no answer} (must not be ${1#!})" ;;
	*) [ "$got" = "$1" ] && ok "$2:$3$4 -> $got" || bad "$2:$3$4 -> ${got:-no answer} (want $1)" ;;
	esac
}
# Through the gateway exactly as cloudflared reaches it (http://gateway:80).
expect 200 "$app" 80 /health
expect '!404' "$app" 80 /login
# Sensor and CI planes reach the API and still demand their own credentials.
expect 401 "$app" 80 /api/v2/sensor/hello
# CI OIDC exchange reaches the API (400 = empty body), not the console's CSRF guard.
post() { # post <path>: status of an empty JSON POST
	dc exec -T gateway sh -c 'wget -U openctem-verify -S -q -O /dev/null -T 10 --header "Host: $1" --header "Content-Type: application/json" --post-data "{}" "http://127.0.0.1:80$2" 2>&1 | sed -n "s/^ *HTTP\/[0-9.]* \([0-9][0-9]*\).*/\1/p" | tail -n 1' _ "$app" "$1"
}
got="$(post /api/v1/ci/oidc/exchange)"
[ "$got" = 400 ] && ok "POST /api/v1/ci/oidc/exchange -> 400 (API)" || bad "POST /api/v1/ci/oidc/exchange -> ${got:-no answer} (want 400 from the API)"
# Internal endpoints stay closed; other host names fail closed.
expect 404 "$app" 80 /metrics
expect 404 "$app" 80 /ready
expect 404 "$app" 80 /debug/pprof/
expect 404 "unknown.invalid" 80 /login
{% endraw %}
{% if openctem_releases[openctem_version].console_service | default(false) | bool and openctem_admin_site != 'off' %}
# The platform console's own site answers (403 from a network outside
# openctem_admin_allowed_cidrs is an answer; 404 or silence is a missing site).
{% if openctem_admin_site == 'host' %}
expect '!404' '{{ openctem_admin_host }}' 80 /login
{% else %}
expect '!404' "$app" {{ openctem_admin_port }} /login
{% endif %}
{% endif %}
exit "$fail"
