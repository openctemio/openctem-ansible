#!/bin/bash
# {{ ansible_managed }}
# Daily OpenCTEM backup: pg_dump (custom format, checked with pg_restore
# --list), the uploaded files (api-data volume), the job signer volumes when
# present, the generated secrets (APP_ENCRYPTION_KEY decrypts stored
# credentials: a dump without it is unusable) and the release state.
#
# Mode age   (/etc/openctem/backup-recipients.txt non-empty): every file is
#            encrypted to the owner's age public key on this server; the
#            plaintext staging copy is deleted. Off-host copy allowed.
# Mode local (no recipient): files stay plaintext in a root-only 0700
#            directory ON THIS HOST. Off-host copy is refused.
set -euo pipefail
umask 077

SECRETS='{{ openctem_secrets_dir }}'
STATE='{{ openctem_state_dir }}'
DEST='{{ backup_dir }}'
BSTATE='{{ backup_state_dir }}'
PG_IMAGE='{{ openctem_postgres_image }}'
KEEP_DAYS='{{ backup_keep_days | int }}'
RECIPIENTS=/etc/openctem/backup-recipients.txt
OFFSITE=/etc/openctem/backup-offsite.sh

log() { echo "openctem-backup: $*"; }
die() { echo 1 > "$BSTATE/last_exit" 2> /dev/null || true; log "ERROR: $*" >&2; exit 1; }
# Compose is always called with an explicit project and file list, never
# from the working directory, and never for another stack's project.
ROOT='{{ openctem_root }}'
PROJECT='{{ openctem_project }}'
case "$PROJECT" in
''|{{ openctem_protected_projects | join('|') }}) echo "refusing compose project '$PROJECT'" >&2; exit 64 ;;
esac
compose_files=(-f "$ROOT/compose.yml")
[ -f "$ROOT/compose.cloudflared.yml" ] && compose_files+=(-f "$ROOT/compose.cloudflared.yml")
dc() { docker compose -p "$PROJECT" --project-directory "$ROOT" "${compose_files[@]}" "$@"; }

mode=local
if [ -s "$RECIPIENTS" ]; then mode=age; command -v age >/dev/null || die "age is not installed"; fi

mkdir -p "$DEST" "$BSTATE"
chmod 0700 "$DEST" "$BSTATE"
exec 9>"$BSTATE/lock"
flock -n 9 || die "another backup is running"

ts="$(date -u +%Y%m%dT%H%M%SZ)"
work="$DEST/.work-$ts"
out="$DEST/$ts"
mkdir -m 0700 "$work"
cleanup() { rm -rf -- "$work"; }
trap cleanup EXIT
trap 'echo 1 > "$BSTATE/last_exit"; log "FAILED"' ERR

log "mode=$mode; database -> custom-format dump"
dc exec -T postgres pg_dump -U postgres -d openctem -Fc --no-owner > "$work/openctem.dump"
[ -s "$work/openctem.dump" ] || die "empty dump"
docker run --rm -i --network none "$PG_IMAGE" pg_restore --list < "$work/openctem.dump" > /dev/null

volume_tar() { # volume_tar <volume> <out>
	docker run --rm --network none -v "${PROJECT}_$1:/v:ro" "$PG_IMAGE" tar -C /v -czf - . > "$2"
}
log "uploaded files (api-data)"
volume_tar api-data "$work/api-data.tar.gz"
for v in signer-keys signer-state; do
	if docker volume inspect "${PROJECT}_$v" > /dev/null 2>&1; then
		log "job signer volume $v"
		volume_tar "$v" "$work/$v.tar.gz"
	fi
done

log "generated secrets (not the tunnel token: it is re-issued from Cloudflare)"
tar -C "$SECRETS" -czf "$work/secrets.tar.gz" \
	db_superuser_password db_migrate_password db_app_password db_console_password redis_password app_encryption_key fingerprint_key metrics_token
deploy_files=()
for f in compose.yml compose.cloudflared.yml .env; do
	[ -f "$ROOT/$f" ] && deploy_files+=("$f")
done
tar -C "$ROOT" -czf "$work/deployment.tar.gz" "${deploy_files[@]}"
cat "$STATE/deployed-version" > "$work/VERSION" 2> /dev/null || echo unknown > "$work/VERSION"
( cd "$work" && sha256sum -- * > SHA256SUMS )

mkdir -m 0700 "$out"
if [ "$mode" = age ]; then
	for f in "$work"/*; do
		age -R "$RECIPIENTS" -o "$out/$(basename "$f").age" "$f"
	done
	( cd "$out" && sha256sum -- *.age > MANIFEST.sha256 )
else
	mv "$work"/* "$out"/
fi
chmod 0600 "$out"/*
log "OK $out ($(du -sh "$out" | cut -f1))"

# Retention.
find "$DEST" -mindepth 1 -maxdepth 1 -type d -name '20*Z' -mtime "+$KEEP_DAYS" -print -exec rm -rf -- {} + | sed 's/^/openctem-backup: retention removed /'
find "$DEST" -mindepth 1 -maxdepth 1 -type d -name '.work-*' ! -name ".work-$ts" -exec rm -rf -- {} +

offsite=no
if [ -x "$OFFSITE" ]; then
	if [ "$mode" = age ]; then
		log "off-host copy"
		"$OFFSITE" "$out"
		offsite=yes
	else
		die "off-host copy refused: backups are not encrypted (set backup_age_recipient)"
	fi
fi

date +%s > "$BSTATE/last_success"
echo 0 > "$BSTATE/last_exit"
echo "$out" > "$BSTATE/last_path"
if [ "$mode" = local ]; then
	log "WARNING: backups are NOT encrypted and NOT off-host: losing this host loses them"
elif [ "$offsite" = no ]; then
	log "WARNING: backups are encrypted but NOT off-host (no off-host copy configured)"
fi
