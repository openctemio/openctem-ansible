#!/bin/bash
# {{ ansible_managed }}
# Host monitor (systemd timer). Checks container health and routing
# (openctem-verify), disk usage, backup freshness, and - from outside, through
# Cloudflare - the tunnel path, the edge certificate, that Access guards the
# console, that the bypassed sensor path still reaches the API, and that the
# API sees the visitor's address there (not the tunnel connector's). Alerts go
# to journald (tag openctem-monitor) and, when configured, to a webhook. Exits 1 while any alert is active.
set -uo pipefail
APP='{{ openctem_app_host }}'
DISK_WARN='{{ monitoring_disk_warn_percent | int }}'
BACKUP_MAX_AGE=$(( {{ monitoring_backup_max_age_hours | int }} * 3600 ))
CERT_WARN=$(( {{ monitoring_cert_warn_days | int }} * 86400 ))
BSTATE='{{ monitoring_backup_state_dir }}'
EXTERNAL='{{ 'yes' if monitoring_external_probes | bool else 'no' }}'
REPEAT='{{ monitoring_repeat_seconds | int }}'
PROJECT='{{ openctem_project }}'
MSTATE=/var/lib/openctem-monitor
ENVF=/etc/openctem/monitor.env
{% raw %}
mkdir -p "$MSTATE"; chmod 0700 "$MSTATE"

alerts=()
alert() { alerts+=("$*"); logger -t openctem-monitor -p user.warning -- "ALERT $*"; }
info() { logger -t openctem-monitor -p user.info -- "$*"; }

# 1. Stack: health, published ports, routing on both host names.
if [ -x /usr/local/sbin/openctem-verify ]; then
	out="$(/usr/local/sbin/openctem-verify 2>&1)" || true
	while IFS= read -r l; do
		case "$l" in FAIL*) alert "stack: ${l#FAIL }" ;; esac
	done <<< "$out"
fi

# 2. Disk.
for m in / /var/lib/docker; do
	[ -d "$m" ] || continue
	use="$(df -P "$m" | awk 'NR==2 { sub(/%/, "", $5); print $5 }')"
	[ -n "$use" ] && [ "$use" -ge "$DISK_WARN" ] && alert "disk $m at ${use}% (warn ${DISK_WARN}%)"
done

# 3. Backups (when installed).
if [ -f /etc/systemd/system/openctem-backup.service ]; then
	last="$(cat "$BSTATE/last_success" 2> /dev/null || echo 0)"
	age=$(( $(date +%s) - last ))
	[ "$age" -gt "$BACKUP_MAX_AGE" ] && alert "last successful backup $(( age / 3600 ))h ago"
	[ "$(cat "$BSTATE/last_exit" 2> /dev/null || echo 0)" != 0 ] && alert "last backup run failed (journalctl -u openctem-backup)"
fi

# 3b. Outbound policy of the stack's containers (when the firewall role installed it).
if [ -f /etc/systemd/system/openctem-egress.service ]; then
	for p in "DOCKER-USER OPENCTEM-EGRESS" "INPUT OPENCTEM-EGRESS-IN"; do
		# shellcheck disable=SC2086
		set -- $p
		iptables -w 10 -C "$1" -j "$2" 2> /dev/null || alert "egress policy: $2 is not active in $1 (systemctl restart openctem-egress)"
	done
fi

# 4. From outside, through Cloudflare.
# challenged <path>: Access must stop an anonymous request (302 to the team
# login or 401/403); a 200 means the path is open without Access.
challenged() {
	local r
	r="$(curl -sS -A "openctem-monitor" -o /dev/null -m 15 -w '%{http_code} %{redirect_url}' "https://$APP$1" 2> /dev/null)"
	case "$r" in
	302\ *cloudflareaccess.com*|401\ *|403\ *) ;;
	*) alert "https://$APP$1 answered '$r' without a Cloudflare Access challenge" ;;
	esac
}
# internal_ip <ip>: private, loopback, link-local, shared (CGNAT) or ULA.
internal_ip() {
	case "$1" in
	10.* | 127.* | 192.168.* | 169.254.* | 172.1[6-9].* | 172.2[0-9].* | 172.3[01].*) return 0 ;;
	100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].*) return 0 ;;
	::1 | [fF][cCdD]*:* | [fF][eE]80:*) return 0 ;;
	esac
	return 1
}
# client_address: one tunnelled request, marked with its own request id; the
# API's log line for it must carry a public client_ip. An internal address
# means the audit log and every per-address limit (sign-in throttling, the CI
# token exchange) see one client for everybody.
client_address() {
	local rid api line ip
	rid="octmon-$(date +%s)-$RANDOM"
	curl -sS -o /dev/null -m 15 -H "X-Request-ID: $rid" "https://$APP/api/v2/sensor/hello" 2> /dev/null || return 0
	api="$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" --filter label=com.docker.compose.service=api | head -n 1)"
	[ -n "$api" ] || return 0
	sleep 2
	line="$(docker logs --since 5m "$api" 2>&1 | grep -F "\"request_id\":\"$rid\"" | tail -n 1)"
	if [ -z "$line" ]; then
		alert "client address: the tunnelled probe (request id $rid) is not in the API log"
		return 0
	fi
	ip="$(sed -n 's/.*"client_ip":"\([^"]*\)".*/\1/p' <<< "$line")"
	if [ -z "$ip" ]; then
		alert "client address: the API log has no client_ip field (API older than the pinned release that records it)"
	elif internal_ip "$ip"; then
		alert "client address: the API sees tunnelled requests as $ip, an internal address; audit addresses and per-address limits are wrong (README, Troubleshooting: client address)"
	fi
}
if [ "$EXTERNAL" = yes ]; then
	challenged /
	challenged /api/v1/me
	# Bypassed machine path: reaches the API (401 = no sensor key), not Access.
	code="$(curl -sS -A "openctem-monitor" -o /dev/null -m 15 -w '%{http_code}' "https://$APP/api/v2/sensor/hello" 2> /dev/null)"
	[ "$code" = 401 ] || alert "sensor path https://$APP/api/v2/sensor/hello answered ${code:-nothing} (want 401: tunnel down, or Access bypass missing)"
	client_address
	if ! echo | openssl s_client -connect "$APP:443" -servername "$APP" 2> /dev/null | openssl x509 -noout -checkend "$CERT_WARN" > /dev/null 2>&1; then
		alert "edge certificate of $APP expires within $(( CERT_WARN / 86400 )) days or could not be read"
	fi
fi

# 5. Notify on change (and repeat every $REPEAT s while active).
digest="$(printf '%s\n' "${alerts[@]:-}" | sha256sum | cut -d' ' -f1)"
prev="$(cat "$MSTATE/digest" 2> /dev/null || true)"
sent="$(cat "$MSTATE/sent_at" 2> /dev/null || echo 0)"
now="$(date +%s)"
if [ "${#alerts[@]}" -eq 0 ]; then
	[ -n "$prev" ] && [ "$prev" != none ] && info "all checks pass again"
	echo none > "$MSTATE/digest"
	exit 0
fi
if [ "$digest" != "$prev" ] || [ $(( now - sent )) -ge "$REPEAT" ]; then
	echo "$digest" > "$MSTATE/digest"
	echo "$now" > "$MSTATE/sent_at"
	WEBHOOK_URL=""
	# shellcheck disable=SC1090
	[ -r "$ENVF" ] && . "$ENVF"
	if [ -n "$WEBHOOK_URL" ]; then
		printf '%s\n' "$(hostname): ${#alerts[@]} OpenCTEM alert(s)" "${alerts[@]}" |
			python3 -c 'import json,sys; print(json.dumps({"text": sys.stdin.read()}))' |
			curl -sS -A "openctem-monitor" -m 10 -o /dev/null -H 'Content-Type: application/json' --data-binary @- "$WEBHOOK_URL" ||
			logger -t openctem-monitor -p user.err -- "webhook delivery failed"
	fi
fi
exit 1
{% endraw %}
