# {{ ansible_managed }}
# Forward all logs to remote syslog/SIEM
*.* action(type="omfwd"
    target="{{ os_baseline_remote_syslog }}"
    port="{{ os_baseline_remote_syslog_port }}"
    protocol="{{ os_baseline_remote_syslog_protocol }}"
    action.resumeRetryCount="-1"
    queue.type="LinkedList"
    queue.filename="fwdRule1"
    queue.maxDiskSpace="1g"
    queue.saveOnShutdown="on")
